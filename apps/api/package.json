    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "bcryptjs": "^3.0.3",
    "socket.io": "^4.8.3",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
