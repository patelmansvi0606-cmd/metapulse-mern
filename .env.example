# Copy to .env and fill in. apps/api and (from Phase 4) apps/worker both
# read from this same file via dotenv — one place to configure a local
# checkout, same as the original's single root .env.example.

# --- Database -----------------------------------------------------------
# Must point at a replica set — even a single-node one — because
# workspace creation and other multi-document writes use a Mongoose
# transaction, and transactions don't work against a standalone mongod.
# Local one-node replica set:
#   mongod --replSet rs0 --dbpath ./data/db
#   mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/metapulse?replicaSet=rs0

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_generated_64_char_hex_secret
JWT_EXPIRES_IN=7d

# --- CORS / cookies --------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- AI providers (both optional — see packages/model-router) --------------
# Leave either or both blank and the app still runs: every AI-backed graph
# node falls back to its deterministic path instead of crashing on boot.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
